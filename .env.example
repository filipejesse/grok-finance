# Meu Pluggy dashboard -> API credentials
PLUGGY_CLIENT_ID=your_client_id
PLUGGY_CLIENT_SECRET=your_client_secret
# Item ID of each connected bank (Meu Pluggy dashboard), comma-separated
PLUGGY_ITEM_IDS=item-id-bank-1,item-id-bank-2
# Only for `python cli.py --email`: Gmail address + app password (myaccount.google.com/apppasswords)
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
